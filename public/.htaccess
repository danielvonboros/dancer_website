# denisonsilva.com — Apache configuration for all-inkl
#
# Vite copies this file from public/ into dist/, so it deploys with the
# site. The legal pages live behind #legal/…, which means the SPA needs
# no rewrite rules of its own.

Options -Indexes

# ---- One address: https://www.denisonsilva.com ------------------------------
# The Let's Encrypt certificate from KAS covers both denisonsilva.com and
# www.denisonsilva.com, so every variant can go to the canonical address.
# Without this, Google sees four copies of the site (http/https × www/bare)
# and Bing already indexes the bare one although the canonical says www.
#
# 301, not 302: only a permanent redirect hands the old address's ranking
# to the new one. /.well-known stays reachable over plain http so KAS can
# renew the certificate.
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.denisonsilva.com%{REQUEST_URI} [R=301,L]

# ---- Caching ----------------------------------------------------------------
<IfModule mod_headers.c>
  # Everything under /assets has a content hash in its name, so it can be
  # cached for a year: a new build produces new file names.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Photos and the hero video: one week. Give a replaced file a new name.
  <FilesMatch "\.(jpe?g|png|webp|svg|mp4|webm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # index.html must never be cached. It names the hashed bundles, and each
  # deploy deletes the old ones: a stale index.html means a blank page.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# ---- Compression ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
</IfModule>

# ---- Keep deploy bookkeeping private ----------------------------------------
# The FTP deploy action leaves a file on the server listing every file it
# uploaded. Nobody outside needs to read it.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
